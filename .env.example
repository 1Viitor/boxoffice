# --- Supabase (server-side data access) ---
# Project: zltrankesrqkeobftmjy
SUPABASE_URL=https://zltrankesrqkeobftmjy.supabase.co

# Publishable or anon key (Settings → API). Used server-side only.
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional: service-role key bypasses RLS (drop 0002_policies.sql if you use this).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- The Numbers scraping ---
THE_NUMBERS_BASE_URL=https://www.the-numbers.com
# Send a realistic browser UA so requests are not blocked
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36
# Minimum milliseconds between outbound requests to the-numbers.com
SCRAPE_RATE_LIMIT_MS=800
